---
import type { WorksLogo } from '../content';

interface Props {
  logo: WorksLogo;
}
const { logo } = Astro.props;
---

{logo === 'api' ? (
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="shrink-0 stroke-current" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m16 18 6-6-6-6M8 6l-6 6 6 6"></path></svg>
) : (
  <img src={`/logos/${logo}.svg`} alt="" width="18" height="18" class="size-4.5 shrink-0" />
)}
