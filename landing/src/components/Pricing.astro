---
import { type Content, links } from '../content';
import { btn, cells, data, h2, headRow, headSide, panel, section, tag } from '../styles/classes';
import Eyebrow from './Eyebrow.astro';

interface Props {
  t: Content;
}
const { t } = Astro.props;
const { pricing } = t;
const row = 'flex min-h-14 items-center px-5 py-3';
const head = 'flex h-12 items-center border-b border-line px-5 text-ui-strong';
const line =
  'flex min-h-12 items-center justify-between gap-3 border-b border-hair px-5 py-2.5 text-ui last:border-b-0';
const tint = (highlight?: true) => (highlight ? 'bg-accent-tint' : 'bg-ground');
---

<section id={t.sections.pricing} class="border-t border-line bg-raised">
  <div class:list={[section, 'flex flex-col gap-10 phone:gap-6']}>
    <div class={headRow}>
      <div class="flex max-w-135 flex-1 flex-col gap-5">
        <Eyebrow>{pricing.eyebrow}</Eyebrow>
        <h2 class={h2}>{pricing.title}</h2>
      </div>
      <p class={headSide}>{pricing.sub}</p>
    </div>
    <div class:list={[cells, 'grid-cols-2 phone:grid-cols-1']}>
      {pricing.plans.map((plan) => (
        <div class="row-span-3 grid min-w-0 grid-cols-1 grid-rows-subgrid">
          <div class:list={['flex flex-col gap-3 px-5 py-6', tint(plan.highlight)]}>
            <span class="flex items-center gap-2 text-ui-strong">{plan.name}{plan.badge && <span class={tag()}>{plan.badge}</span>}</span>
            <div class="flex h-13 items-center gap-1.5"><span class="text-headline">{plan.price}</span><span class="self-end pb-2 text-small text-muted">{pricing.perMonth}</span></div>
            <a href={links.signUp} class:list={[btn(plan.highlight ? 'primary' : 'outline', 'md'), 'max-w-75']}>{plan.cta}</a>
          </div>
          <span class:list={[row, tint(plan.highlight), 'text-ui-strong']}>{plan.credits}</span>
          <span class:list={[row, tint(plan.highlight), 'text-ui text-soft']}>{plan.equivalent}</span>
        </div>
      ))}
    </div>
    <div class="grid grid-cols-[minmax(0,1fr)_minmax(0,1fr)] items-start gap-10 tablet:grid-cols-1 tablet:gap-4">
      <div class:list={[panel, 'overflow-hidden']}>
        <p class={head}>{pricing.costsTitle}</p>
        <dl class="flex flex-col">
          {pricing.costs.map((c) => <div class={line}><dt class="text-soft">{c.label}</dt><dd class:list={[data, 'whitespace-nowrap']}>{c.value}</dd></div>)}
        </dl>
      </div>
      <div class="flex flex-col gap-4">
        <div class:list={[panel, 'overflow-hidden']}>
          <p class={head}>{pricing.packsTitle}</p>
          <dl class="flex flex-col">
            {pricing.packs.map((p) => <div class={line}><dt class="text-soft">{p.label}</dt><dd class:list={[data, 'whitespace-nowrap']}>{p.value}</dd></div>)}
          </dl>
          <p class="border-t border-line px-5 py-3 text-ui text-soft">{pricing.packsNote}</p>
        </div>
        {/* The worked example prices a whole campaign with the rows above, so a reader can redo it for theirs. */}
        <div class:list={[panel, 'overflow-hidden']}>
          <p class={head}>{pricing.example.title}</p>
          <p class:list={[data, 'border-b border-hair px-5 py-3 text-ink']}>{pricing.example.cost}</p>
          <p class:list={[data, 'border-b border-hair px-5 py-3 text-ink']}>{pricing.example.buy}</p>
          <p class="px-5 py-3 text-ui text-soft">{pricing.example.note}</p>
        </div>
      </div>
    </div>
    <div class="grid grid-cols-3 gap-10 text-ui text-soft tablet:grid-cols-1 tablet:gap-3"><p>{pricing.welcome}</p><p>{pricing.expiry}</p><p>{pricing.agencies}</p></div>
  </div>
</section>
