---
import { type Content, type Locale, locales } from '../content';

interface Props {
  locale: Locale;
  canonical: URL;
  t: Content;
}

const { locale, canonical, t } = Astro.props;

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://zenbree.com';
const logoUrl = `${siteUrl}/favicon.svg`;
// The 1200×630 card, built from docs/brand/og-card.html.
const ogImageUrl = `${siteUrl}/og-${locale}.png`;
// Open Graph names a language with its territory.
const OG_LOCALES: Record<Locale, string> = { it: 'it_IT', en: 'en_US', es: 'es_ES', fr: 'fr_FR' };

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Zenbree',
    url: siteUrl,
    logo: logoUrl,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Zenbree',
    url: siteUrl,
    inLanguage: locale,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Zenbree',
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web',
    description: t.meta.description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: t.faq.items.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.a,
      },
    })),
  },
];
---

<meta property="og:type" content="website" />
<meta property="og:site_name" content="Zenbree" />
<meta property="og:url" content={canonical.toString()} />
<meta property="og:title" content={t.meta.title} />
<meta property="og:description" content={t.meta.description} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={t.meta.title} />
<meta property="og:locale" content={OG_LOCALES[locale]} />
{locales.filter((l) => l !== locale).map((l) => <meta property="og:locale:alternate" content={OG_LOCALES[l]} />)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={t.meta.title} />
<meta name="twitter:description" content={t.meta.description} />
<meta name="twitter:image" content={ogImageUrl} />

{jsonLd.map((schema) => (
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
))}
