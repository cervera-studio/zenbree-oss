# Infra
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zenbree
REDIS_URL=redis://localhost:6379/0
WEB_ORIGIN=http://localhost:3000
# Better Stack error tracking; empty = off
BETTERSTACK_API_ERROR_DSN=

# Better Auth jwt plugin (web app)
AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks
AUTH_ISSUER=http://localhost:3000
AUTH_AUDIENCE=http://localhost:3000

# LLM: DeepSeek primary -> Anthropic fallback
LLM_PRIMARY_PROVIDER=deepseek
CHAT_PRIMARY_PROVIDER=deepseek
LLM_SAME_PROVIDER_RETRIES=0
LLM_SAME_PROVIDER_RETRY_BACKOFF_SECONDS=0.3
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
# HMAC key for the per-user DeepSeek cache id; empty = user_id not sent
DEEPSEEK_USER_ID_SECRET=
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6
# Cloudflare AI Gateway; account+name empty = direct to providers
CF_AI_GATEWAY_ACCOUNT_ID=
CF_AI_GATEWAY_NAME=
CF_AI_GATEWAY_TOKEN=

# Outreach send window
OUTREACH_SEND_WINDOW_START_HOUR=9
OUTREACH_SEND_WINDOW_END_HOUR=18
OUTREACH_SEND_WINDOW_TIMEZONE=Europe/Rome

# m1-tools: vendors + LinkedIn (Unipile); empty key = that vendor is off
APOLLO_API_KEY=
APOLLO_BASE_URL=https://api.apollo.io/v1
AIARK_API_KEY=
AIARK_BASE_URL=https://api.ai-ark.com/api/developer-portal
TREG_API_KEY=
TREG_BASE_URL=https://treg.superdesign.dev
SERPER_API_KEY=
# empty = MX-only email check
MILLIONVERIFIER_API_KEY=
# e.g. https://api8.unipile.com:13851
UNIPILE_DSN=
UNIPILE_API_KEY=
# static header Unipile sends (it does not sign)
UNIPILE_WEBHOOK_SECRET=
UNIPILE_WEBHOOK_AUTH_HEADER=Unipile-Auth
# Fernet key: hosted-auth state + stored account id
OAUTH_TOKEN_ENCRYPTION_KEY=
# where Unipile calls back, e.g. https://api.zenbree.com
API_PUBLIC_BASE_URL=

# feature/m1-agent: web_search / fetch_page
FIRECRAWL_API_KEY=
# Exa uses REST directly; EXA_MCP_URL is no longer used
EXA_ENABLED=false
EXA_API_KEY=

# m1-billing-admin: Stripe top-ups + plans (test keys in dev: "Zenbree sandbox")
STRIPE_SECRET_KEY=
# whsec_… of the endpoint <api>/v1/billing/stripe-webhook. Events: checkout.session.completed,
# checkout.session.async_payment_succeeded, invoice.paid, invoice_payment.paid,
# customer.subscription.created/updated/deleted, charge.refunded.
# Portal: upgrades prorated with always_invoice, downgrades scheduled at period end. Local: stripe listen --forward-to localhost:8000/v1/billing/stripe-webhook
STRIPE_WEBHOOK_SECRET=
# Packs (one-off) and plans (monthly; credits granted on every paid invoice): JSON lists,
# entries without stripe_price_id are hidden. Prices are VAT-exclusive (Stripe Tax adds IVA).
# Price ids below are the sandbox ones; live needs its own.
# BILLING_PACKS=[{"id":"starter","credits":350,"price_eur_cents":1900,"stripe_price_id":"price_1ULjnFIepLn1nrMHVfSxQ2el"},{"id":"growth","credits":1000,"price_eur_cents":4900,"stripe_price_id":"price_1ULjnHIepLn1nrMHrjBwPRiX"},{"id":"scale","credits":3000,"price_eur_cents":14900,"stripe_price_id":"price_1ULjnJIepLn1nrMHG2AP73XA"}]
# BILLING_PLANS=[{"id":"starter","credits":500,"price_eur_cents":2900,"stripe_price_id":"price_1ULjnKIepLn1nrMHhz2D7RZi"},{"id":"pro","credits":1500,"price_eur_cents":7900,"stripe_price_id":"price_1ULjnLIepLn1nrMHtTIJmizH"}]
# Margin in /v1/admin/costs: USD costs converted at this rate
EUR_PER_USD=0.86

# E7 sending mailboxes: send-only OAuth apps (gmail.send / Graph Mail.Send); empty = provider off.
# Redirect URI to register: <API_PUBLIC_BASE_URL>/v1/integrations/mailboxes/<google|microsoft>/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
# E7 email step: signed Reply-To domain + HMAC secret (also the List-Unsubscribe mailto).
# Leave empty until the inbound reply receiver (#86) is live, or replies are lost.
OUTREACH_REPLY_DOMAIN=
# Also signs the one-click unsubscribe link (#172); its URLs: UNSUBSCRIBE_ORIGIN below.
OUTREACH_REPLY_SECRET=
# E8 inbound replies: Resend inbound webhook secret (whsec_…) for POST /v1/inbound/email.
# RESEND_API_KEY / EMAIL_FROM are shared with web (root .env): reading received mail + reply notices.
OUTREACH_INBOUND_WEBHOOK_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
# Unsubscribe host (#220): footer link + RFC 8058 one-click go to <origin>/x/<token> (served by web).
# Empty: page on WEB_ORIGIN/u/<token>, one-click on API_PUBLIC_BASE_URL. Same variable in web/.env.example.
UNSUBSCRIBE_ORIGIN=
# Flower (#361): `user:password` for its basic auth, read by Flower itself. Under compose it comes
# from the root `.env` (see the root `.env.example`) and the service refuses to start while it is empty;
# in prod it is a strong value in Infisical. Set it here only to run Flower outside compose.
FLOWER_BASIC_AUTH=
# Web Push (#343): browser alerts with no Zenbree tab open. Empty keys = push inert, the web keeps the in-page alert.
# Public key: URL-safe base64 uncompressed P-256 point. Subject: a mailto: or https: contact.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# E13.1 HubSpot read gate: one public HubSpot app, per-user OAuth; empty = off.
# The app (redirect URI, scopes, webhooks) is the HubSpot project in ops/hubspot: see its README.
HUBSPOT_OAUTH_CLIENT_ID=
HUBSPOT_OAUTH_CLIENT_SECRET=

# Instantly (#929): each project connects its own workspace with its own API key (stored encrypted), so no key here.
# Only a test or a stand-in server (/verify) changes the base URL.
INSTANTLY_API_BASE_URL=https://api.instantly.ai

# Profile photos (#503): an R2 bucket with an Object Read & Write token scoped to it. Empty = off (needs API_PUBLIC_BASE_URL too).
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PHOTOS_BUCKET=

# Bounces (#747): the Pub/Sub topic Gmail pushes new mail to (gmail-api-push@system.gserviceaccount.com publishes), and
# the secret its push subscription puts in the URL: <API_PUBLIC_BASE_URL>/v1/integrations/mailboxes/google/push?token=...
# Empty = Gmail bounces are not read. Microsoft needs only API_PUBLIC_BASE_URL and OUTREACH_REPLY_SECRET.
GMAIL_PUSH_TOPIC=
GMAIL_PUSH_TOKEN=

# Log level: debug | info | warning | error (default info); errors are never muted. Same variable as the web (web/lib/logger.ts).
LOG_LEVEL=info
