# Copy to .env for local overrides. `docker compose up` also works without it.
POSTGRES_USER=zenbree
POSTGRES_PASSWORD=postgres
POSTGRES_DB=zenbree
POSTGRES_PORT=5432
DATABASE_URL=postgresql://zenbree:postgres@postgres:5432/zenbree
REDIS_URL=redis://redis:6379/0
API_BASE_URL=http://api:8000

# Flower basic auth, `user:password`: the `flower` service does not start without it (#361).
# This value is for local use only. In prod set a strong one in Infisical (`zenbree` project, `prod`
# environment) before the deploy that brings #361, or Flower restarts in a loop until it is there.
FLOWER_BASIC_AUTH=dev:zenbree-dev-1234

# Browser API URL is baked into the web image at build time.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Better Stack errors app zenbree-web; embedded in the web build.
NEXT_PUBLIC_BETTERSTACK_WEB_ERROR_DSN=
# The marketing site (landing/, compose service `landing`). The app's signed-out `/` and old
# `/welcome` links redirect there, and the help menu opens its FAQ. Empty: no redirect, `/` shows sign-in.
NEXT_PUBLIC_LANDING_URL=http://localhost:4321

# Optional app credentials; see api/.env.example and web/.env.example.

# Better Stack errors app zenbree-api.
BETTERSTACK_API_ERROR_DSN=

# Prod only, read by ops/backup.sh (R2 credentials live in rclone config, remote "r2").
BACKUP_BUCKET=zenbree-backups
BACKUP_HEARTBEAT_URL=

# Log level of the api, worker, beat and web containers: debug | info | warning | error (default info).
# A change needs only `docker compose up -d` (recreate), not a new image. In prod: Infisical, then recreate.
# LOG_LEVEL=info

# Sentinel project identification URL: public, baked into the web image at build time.
BETTER_AUTH_IDENTIFY_URL=
