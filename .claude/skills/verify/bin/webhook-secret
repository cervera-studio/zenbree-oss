#!/usr/bin/env bash
# Keeps an automation's webhook secret out of the evidence. It never prints the secret.
#
#   bin/webhook-secret save          read the secret from the open "Copia il segreto ora" dialog into
#                                    $VERIFY_STATE/hook-secret, keep the one before as hook-secret.old,
#                                    and mask the dialog's inputs for screenshots
#   bin/webhook-secret redact <file>...  replace every whsec_ key in the files with whsec_<redacted>
#
# save needs VERIFY_ID and VERIFY_STATE, as bin/browser does.
set -euo pipefail
browser="$(dirname "$0")/browser"

save() {
  [ -n "${VERIFY_STATE:-}" ] || { echo 'webhook-secret: set VERIFY_STATE (eval "$(bin/stack env)")' >&2; exit 2; }
  local file="$VERIFY_STATE/hook-secret" secret
  secret="$("$browser" eval "document.querySelectorAll('[role=dialog] input')[1]?.value ?? null" | tr -d '"\n')"
  case "$secret" in
    whsec_*) ;;
    *) echo 'webhook-secret: the dialog shows no whsec_ secret: open it first' >&2; exit 1 ;;
  esac
  # A second save of the same dialog must keep .old, or --old-key signs with the current secret.
  if [ "$(cat "$file" 2>/dev/null)" != "$secret" ]; then
    [ ! -f "$file" ] || mv "$file" "$file.old"
    (umask 077 && printf '%s\n' "$secret" > "$file")
  fi
  # Mask, never overwrite input.value: a --width screenshot resizes the page and React puts the secret back.
  "$browser" eval "document.head.insertAdjacentHTML('beforeend', '<style>[role=dialog] input{-webkit-text-security:disc}</style>')" > /dev/null
  echo "webhook-secret: saved to $file and masked the dialog"
  [ ! -f "$file.old" ] || echo "webhook-secret: the secret before is in $file.old"
}

case "${1:-}" in
  save) save ;;
  # perl, not sed -E: a / in a bracket does not match on macOS.
  redact) shift; [ $# -gt 0 ] || { echo 'usage: bin/webhook-secret redact <file>...' >&2; exit 2; }
    perl -pi -e 's/whsec_[A-Za-z0-9+\/=]+/whsec_<redacted>/g' "$@" ;;
  *) echo 'usage: bin/webhook-secret save | redact <file>...' >&2; exit 2 ;;
esac
