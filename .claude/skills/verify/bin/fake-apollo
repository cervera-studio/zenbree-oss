#!/usr/bin/env node
// Apollo's organization endpoints for the watchlist recipe (features/watchlists.md). Organization ids pick the
// answer: "hiring" has two postings and gains a third once /more was called, "quiet" has none, "broken" is a 500.
// The people search (features/saved-searches.md) answers three people of "hiring", whatever the filters.
import { createServer } from 'node:http';

const port = Number(process.argv[2] ?? 18767);
const day = 86_400_000;
const posting = (title, n, daysAgo) => ({
  title,
  city: 'Milano',
  country: 'Italy',
  url: `https://jobs.verify.test/${n}`,
  posted_at: new Date(Date.now() - daysAgo * day).toISOString(),
});
let more = false;
const person = (id, first_name, title) => ({
  id,
  first_name,
  last_name_obfuscated: 'Ro***i',
  title,
  organization: { name: 'Hiring Srl', primary_domain: 'hiring.verify.test' },
});
const people = [
  person('p1', 'Anna', 'Head of Sales'),
  person('p2', 'Bruno', 'Head of Sales Italy'),
  person('p3', 'Carla', 'VP Sales'),
];

function postings(id) {
  if (id === 'broken') return [500, { error: 'down' }];
  if (id === 'quiet') return [200, { organization_job_postings: [], pagination: { total_entries: 0 } }];
  if (id !== 'hiring') return [404, { error: 'not found' }];
  const open = [posting('Senior SDR', 1, 0), posting('SDR Italia', 2, 30), posting('Backend engineer', 3, 2)];
  if (more) open.push(posting('SDR Team Lead', 4, 0));
  return [200, { organization_job_postings: open, pagination: { total_entries: open.length } }];
}

createServer((req, res) => {
  const url = new URL(req.url, 'http://fake');
  const jobs = url.pathname.match(/\/organizations\/([^/]+)\/job_postings$/);
  let answer = [404, { error: 'not found' }];
  if (jobs) answer = postings(jobs[1]);
  else if (url.pathname.endsWith('/mixed_people/api_search'))
    answer = [200, { people, total_entries: people.length }];
  else if (url.pathname.endsWith('/organizations/enrich'))
    // Only hiring.verify.test is a known domain.
    answer =
      url.searchParams.get('domain') === 'hiring.verify.test'
        ? [200, { organization: { id: 'hiring', name: 'Hiring Srl', primary_domain: 'hiring.verify.test' } }]
        : [404, { error: 'not found' }];
  else if (url.pathname === '/more') {
    more = true;
    answer = [200, { more }];
  }
  console.log(`${req.method} ${url.pathname}${url.search} -> ${answer[0]}`);
  res.writeHead(answer[0], { 'Content-Type': 'application/json' }).end(JSON.stringify(answer[1]));
}).listen(port, () => console.log(`fake-apollo on :${port}`));
