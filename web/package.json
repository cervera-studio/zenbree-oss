{
  "name": "zenbree-web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "node lint/gen-message-types.mjs && next build",
    "start": "next start",
    "lint": "biome check . && oxlint -c .oxlintrc.json && node lint/guard.mjs",
    "lint:gen": "node lint/gen-tailwind-scale.mjs",
    "format": "biome check --fix .",
    "typecheck": "node lint/gen-message-types.mjs && tsc --noEmit --incremental false",
    "test": "vp test run",
    "knip": "knip",
    "auth:generate": "auth generate --config lib/auth.ts --output ../api/db/$(date -u +%Y%m%d%H%M%S)_better_auth.sql -y",
    "api:types": "node lint/gen-api-types.mjs",
    "api:types:check": "node lint/gen-api-types.mjs --check"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^4.0.0",
    "@better-auth/infra": "0.4.13",
    "@sentry/nextjs": "^11.2.0",
    "@shadcn/react": "0.3.1",
    "@standard-schema/spec": "^1.1.0",
    "@tanstack/react-table": "^9.2.4",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.49.0",
    "motion": "^13.5.0",
    "next": "^16.3.8",
    "next-intl": "^4.14.8",
    "next-themes": "0.4.6",
    "pg": "^8.23.1",
    "posthog-js": "^1.435.6",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@formatjs/icu-messageformat-parser": "^3.5.20",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "24.19.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "auth": "^1.7.7",
    "eslint-plugin-react-you-might-not-need-an-effect": "1.0.2",
    "fast-check": "^4.10.2",
    "happy-dom": "^20.14.5",
    "knip": "^6.39.0",
    "lefthook": "^2.1.16",
    "openapi-typescript": "^7.13.0",
    "oxlint": "1.88.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite-plus": "1.3.0"
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "@tailwindcss/oxide",
      "esbuild",
      "lefthook",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "vite": "*"
      }
    }
  }
}
