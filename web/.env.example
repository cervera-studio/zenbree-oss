# Postgres (same DB as the API; Better Auth tables from the api/db migrations)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/zenbree

# Better Auth: `openssl rand -hex 32`; URL = public origin of this app (also JWT iss/aud)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Better Auth Infrastructure (dashboard and Sentinel) API key
BETTER_AUTH_API_KEY=
# Resend: verification and password-reset email (#221); shared with the API (root .env). Unset = not sent.
RESEND_API_KEY=
EMAIL_FROM=

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Python API: internal base URL for server-side calls, public one for the browser
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Unsubscribe host (#220), e.g. https://u.zenbree.com: serves only /x/<token>, and the app's /u/<token>
# redirects there. Same variable in api/.env.example. Empty: the page stays at /u/<token>.
UNSUBSCRIBE_ORIGIN=

# The marketing site (landing/, build-time). A signed-out `/` and old `/welcome` links redirect there,
# and the help menu opens its FAQ. Empty, malformed or this app's own host: no redirect, `/` shows sign-in.
NEXT_PUBLIC_LANDING_URL=http://localhost:4321

# Better Stack errors app zenbree-web (build-time; unset → no-op).
NEXT_PUBLIC_BETTERSTACK_WEB_ERROR_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Server log level for `lib/logger.ts`: debug | info | warning | error (runtime, default info); same
# variable and names as the API. The browser logs warning+ in production; for more, in its console:
# `localStorage.setItem('zb-log-level', 'debug')`.
LOG_LEVEL=info

# Sentinel project identification URL: public, baked into the web image at build time.
BETTER_AUTH_IDENTIFY_URL=
